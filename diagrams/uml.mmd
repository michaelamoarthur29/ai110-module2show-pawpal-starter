classDiagram
    %% PawPal+ — matches the implementation in pawpal_system.py

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet Pet) Pet
        +get_pets() list~Pet~
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task Task) Task
        +get_tasks() list~Task~
        +has_task(title str, date_time datetime) bool
    }

    %% Task.priority: "high" | "medium" | "low"
    %% Task.frequency: "none" | "daily" | "weekly"
    class Task {
        +str title
        +str task_type
        +datetime date_time
        +int duration_minutes
        +str priority
        +bool completed
        +str frequency
        +mark_complete() None
        +mark_incomplete() None
        +end_time() datetime
        +is_recurring() bool
        +next_occurrence() Task
        +overlaps(other Task) bool
        +priority_rank() int
    }

    class Scheduler {
        +Owner owner
        +pets() list~Pet~
        +get_all_tasks() list~Task~
        +pet_for(task Task) Pet
        +sort_by_time(tasks list) list~Task~
        +get_sorted_tasks() list~Task~
        +get_daily_tasks(day date) list~Task~
        +tasks_touching(day date) list~Task~
        +filter_by_pet(pet_name str) list~Task~
        +filter_by_status(completed bool) list~Task~
        +filter_tasks(pet_name str, completed bool, day date) list~Task~
        +detect_conflicts(day date) list~tuple~
        +conflict_warnings(day date) list~str~
        +mark_task_complete(task Task) Task
        +create_recurring_tasks(until date) list~Task~
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler "1" --> "1" Owner : reads tasks through
